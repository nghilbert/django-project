# Copy this file to .env and fill in the values. Never commit .env.

# Fine for local development. For a real deployment, replace it with a random secret:
#   uv run python -c "import secrets; print(secrets.token_urlsafe(50))"
DJANGO_SECRET_KEY=replace-with-random-secret-in-production

DJANGO_DEBUG=True

# Comma-separated
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# Optional: send real emails through a dedicated project Gmail account.
# Leave these commented out to print emails to the development terminal.
# Enable Google 2-Step Verification, then create an app password for Skill Matchmaker.
# Use that 16-character app password without spaces, never your Google login password.
# DJANGO_EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
# DJANGO_EMAIL_HOST=smtp.gmail.com
# DJANGO_EMAIL_PORT=587
# DJANGO_EMAIL_HOST_USER=your-project-account@gmail.com
# DJANGO_EMAIL_HOST_PASSWORD=replace-with-google-app-password
# The sender defaults to: Skill Matchmaker <DJANGO_EMAIL_HOST_USER>
# Optional display name override; keep the same Gmail address:
# DJANGO_DEFAULT_FROM_EMAIL="Skill Matchmaker <your-project-account@gmail.com>"
