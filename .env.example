# Copy this file to .env and fill in the values. Never commit .env.

# Fine for local development. For a real deployment, replace it with a random secret:
#   uv run python -c "import secrets; print(secrets.token_urlsafe(50))"
DJANGO_SECRET_KEY=replace-with-random-secret-in-production

DJANGO_DEBUG=True

# Comma-separated
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
